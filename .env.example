# Copy to .env and fill in only what you want. Every line is optional:
# with no .env at all the app still runs, for free.

# ---------------------------------------------------------------- answers
# auto (default) | gemini | groq | ollama | extractive
RAG_LLM=auto

# Google AI Studio - free tier, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq - free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Pin a model only if you want to; blank means "ask the provider what is
# available today and pick a free one", which survives model deprecations.
GEMINI_MODEL=
GROQ_MODEL=

# Local models via Ollama (https://ollama.com) - no key, works offline
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------- retrieval
# auto (default) | tfidf | st
#   tfidf = scikit-learn, no download at all
#   st    = local sentence-transformers embeddings (pip install -r requirements-optional.txt)
RAG_EMBEDDINGS=auto
RAG_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_MIN_SCORE=0.02
RAG_MAX_UPLOAD_MB=25
RAG_DATA_DIR=
